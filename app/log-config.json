{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "default": {
      "format": "%(asctime)s %(levelname)s %(name)s %(message)s"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "formatter": "default",
      "stream": "ext://sys.stdout"
    }
  },
  "loggers": {
    "uvicorn": {
      "handlers": [
        "console"
      ],
      "level": "INFO",
      "propagate": true
    },
    "uvicorn.error": {
      "level": "INFO",
      "propagate": true
    },
    "uvicorn.access": {
      "level": "INFO",
      "propagate": true
    }
  }
}
